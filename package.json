{
  "name": "forex-trading-journal-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "REST API for the Forex Trading Journal (Express + Prisma + PostgreSQL/Neon)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "build": "prisma generate && prisma migrate deploy",
    "prisma:generate": "prisma generate",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "seed:admin": "node src/utils/seedAdmin.js",
    "backup": "sh scripts/backup.sh",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "@prisma/client": "^6.5.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.0.0",
    "nodemailer": "^6.9.16",
    "prisma": "^6.5.0",
    "zod": "^3.24.1"
  }
}
