# ---------- Server ----------
NODE_ENV=development
PORT=4000

# ---------- Database (Neon PostgreSQL) ----------
# DATABASE_URL: the POOLED connection string (host contains "-pooler"). Used by the running API.
# DIRECT_URL:   the DIRECT (non-pooled) connection string. Used by `prisma migrate`.
# Both must end with ?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# ---------- Auth ----------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-characters

# ---------- CORS ----------
# Comma-separated list of allowed frontend origins (no trailing slash)
FRONTEND_URL=http://localhost:5173

# ---------- Initial admin (created/promoted on server start and by `npm run seed:admin`) ----------
# The admin is created only if no user with this email exists. An existing password is never overwritten.
ADMIN_EMAIL=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_FULL_NAME=Administrator

# ---------- Email for password reset (optional) ----------
# Without SMTP, an admin can generate a one-time reset link from the Admin Panel.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Forex Trading Journal <no-reply@example.com>"
